# ========================================================
# SMART STUDY MATERIAL SHARING PLATFORM - BACKEND ENV
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production or Local MongoDB in Dev)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_study_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart_study_db

# JWT Authentication Secret & Token Expiry
JWT_SECRET=smart_study_jwt_secret_key_super_secure_btech_cse_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Initial Admin Credentials (used during npm run seed)
ADMIN_EMAIL=admin@smartstudy.edu
ADMIN_PASSWORD=Admin@123

# Cloudinary Cloud Storage (Required for Production Deployment on Render)
# Sign up free at https://cloudinary.com
# Leave blank during local development to use automatic local storage fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
